# Copy to .env and edit. Every value is optional; the app runs with none of them set.

# --- Answer generation ---------------------------------------------------
# auto        -> use Ollama if running, else a hosted API if a key is set, else extractive
# extractive  -> sentence ranking only (no LLM, no key) - always works
# ollama      -> force the local Ollama model
# hosted      -> force the hosted API below
ANSWER_MODE=auto

# Local LLM through Ollama (free): install from https://ollama.com, then `ollama pull llama3.2:3b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional hosted LLM. Never commit real keys. Paid/limited services are NOT required.
HOSTED_PROVIDER=openai            # openai (any OpenAI-compatible endpoint) | anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # e.g. https://api.groq.com/openai/v1 for Groq
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SCORE_THRESHOLD=0.30
STRONG_SCORE=0.50

# Silences a harmless tokenizers fork warning
TOKENIZERS_PARALLELISM=false
